<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_feed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iv_header_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/tv_feed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_recent_notifications_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/btn_feed_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_widget_action"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/desc_refresh"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <!-- Open App Button -->
        <ImageButton
            android:id="@+id/btn_feed_open_app"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_action"
            android:src="@drawable/ic_notification"
            android:contentDescription="@string/desc_open_vault"
            android:padding="6dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_card_stroke"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null" />

    <!-- List & Empty View Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_widget_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/widget_card_stroke"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tv_widget_feed_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_empty_notifications"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
