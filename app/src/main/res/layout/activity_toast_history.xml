<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- AppBarLayout (fitsSystemWindows="true" matches activity_main.xml) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="?attr/colorSurface"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:elevation="0dp"
            app:title="@string/toast_logs_title"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:navigationIcon="?attr/homeAsUpIndicator">

            <!-- Circular Progress Ring (Pure Minimalist Border Progress Indicator) -->
            <FrameLayout
                android:id="@+id/card_toolbar_decryption"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_toolbar_decryption"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    app:indicatorSize="20dp"
                    app:trackThickness="3.5dp"
                    app:trackCornerRadius="2dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceContainerHighest"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0" />

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toolbar_accessibility_alert"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_toast_permission"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnErrorContainer"
                app:backgroundTint="?attr/colorErrorContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorError"
                android:contentDescription="@string/desc_enable_toast_permission"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="@string/source"
                style="@style/Widget.Material3.Button.TextButton"
                app:icon="@drawable/ic_code"
                app:iconPadding="4dp"
                app:iconTint="?attr/colorPrimary"
                android:textColor="?attr/colorPrimary" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container with standard Scrolling View Behavior (matches MainActivity fragments) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 1. Quick Action Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Date Filter Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_open_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_date_range"
                    app:chipIcon="@drawable/ic_calendar"
                    app:chipIconSize="18dp"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    style="@style/Widget.Material3.Chip.Assist.Elevated" />

                <!-- Filter by App Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_filter_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/filter_by_app"
                    app:chipIcon="@drawable/sel_nav_apps"
                    app:chipIconSize="18dp"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    style="@style/Widget.Material3.Chip.Assist.Elevated" />

                <!-- Clear All Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_clear_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/clear_all"
                    app:chipIcon="@drawable/ic_delete_sweep"
                    app:chipIconSize="18dp"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    style="@style/Widget.Material3.Chip.Assist.Elevated" />

                <!-- Show All / Reset Filters Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/btn_reload_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/show_all"
                    app:chipIcon="@drawable/ic_close"
                    app:chipIconSize="18dp"
                    app:chipCornerRadius="12dp"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    android:visibility="gone"
                    style="@style/Widget.Material3.Chip.Assist.Elevated" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- 2. Active Removable Filter Strip (App Filter or Date Filter) -->
        <LinearLayout
            android:id="@+id/scroll_active_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_active_app_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App: WhatsApp"
                app:chipIcon="@drawable/sel_nav_apps"
                app:closeIconVisible="true"
                android:visibility="gone"
                style="@style/Widget.Material3.Chip.Input" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_active_date_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Date: Aug 28"
                app:chipIcon="@drawable/ic_calendar"
                app:closeIconVisible="true"
                android:visibility="gone"
                style="@style/Widget.Material3.Chip.Input" />

        </LinearLayout>

        <!-- RecyclerView list -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                tools:listitem="@layout/item_toast" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_button_circle_ripple"
                    android:backgroundTint="?attr/colorSurfaceContainerHigh">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_toast_bread"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/empty_toasts_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_accessibility_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/empty_toasts_desc"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_grant_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/enable_in_settings"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:icon="@drawable/sel_nav_settings"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Biometric Lock Overlay Screen -->
    <LinearLayout
        android:id="@+id/layout_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_overlay_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_access_toast_logs"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unlock"
            android:layout_marginTop="24dp"
            app:icon="@drawable/ic_lock" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
