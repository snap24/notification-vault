<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingHorizontal="16dp">

    <!-- Batch Selection Bar (shown in multi-select mode) -->
    <LinearLayout
        android:id="@+id/layout_batch_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_all"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/selected_count_format"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            style="@style/Widget.Material3.Button.TonalButton"
            app:icon="@drawable/ic_delete_sweep"
            app:iconTint="?attr/colorError"
            android:textColor="?attr/colorError"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btn_cancel_selection"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_square_ripple"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/desc_cancel_selection"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

    <!-- Header Stats Banner -->
    <LinearLayout
        android:id="@+id/layout_header_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_apps_header_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tracked Applications"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_total_notifications_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 notifications"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/bg_widget_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

    </LinearLayout>

    <!-- Search bar for apps -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_tracked_apps_hint"
        android:layout_marginBottom="8dp"
        app:startIconDrawable="@drawable/ic_search"
        app:endIconMode="clear_text"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusBottomEnd="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="48dp"
            android:paddingVertical="10dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Sorting Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Most Alerts"
                android:checked="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔤 Name (A–Z)"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sort_least"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Least Alerts"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp"
            android:overScrollMode="never"
            tools:listitem="@layout/item_app" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_apps"
                app:tint="?attr/colorOutline"
                android:layout_marginBottom="16dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_apps_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_apps_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="32dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
