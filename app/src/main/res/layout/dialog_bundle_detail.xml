<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Header: App Icon + Name + Subtitle + Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_bundle_app_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                android:src="@android:drawable/sym_def_app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_bundle_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_bundle_sub_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_bundle_decrypt"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                app:indicatorSize="20dp"
                app:trackThickness="3.5dp"
                app:trackCornerRadius="2dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceContainerHighest"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_bundle_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_circle_ripple"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/close" />

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.4" />

        <!-- Skeleton Loading Container -->
        <LinearLayout
            android:id="@+id/layout_bundle_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/item_notification_skeleton" />
            <include layout="@layout/item_notification_skeleton" />
            <include layout="@layout/item_notification_skeleton" />

        </LinearLayout>

        <!-- Scrollable Bundle Items List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_bundle_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical" />

        <!-- Action Buttons Row: Copy All, Star All, Open App, Delete All (4 Equal Columns, at the bottom for thumb reach) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bundle_copy_all"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/copy_all"
                android:textSize="11.5sp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_copy"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:cornerRadius="10dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bundle_star_all"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/desc_star"
                android:textSize="11.5sp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_star_border"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:cornerRadius="10dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bundle_open_app"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/open_app"
                android:textSize="11.5sp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_open_in_new"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:cornerRadius="10dp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bundle_delete_all"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/delete_all"
                android:textSize="11.5sp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_trash_bin"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:cornerRadius="10dp"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
