    <!-- Accessibility Instructions -->
    <string name="accessibility_instruction_step1">To record background toasts, please follow these steps:\n\n1. Find \'NotiVault Toast Recorder\' in the accessibility service list and turn it on.</string>
    <string name="accessibility_instruction_step2">Note: If the setting is greyed out with a \'Restricted setting\' warning:\n\n• Go to your phone\'s Home screen, long-press the \'Notification Vault\' app icon, and tap \'App info\'.\n• Tap the three-dots menu in the top-right and select \'Allow restricted settings\'.\n• Return here or go to accessibility settings and enable \'NotiVault Toast Recorder\'.</string>

    <!-- Permission Instructions -->
    <string name="permission_instruction_step1">To record notifications, please follow these steps:\n\n1. Find \'Notification Vault\' in the list and tap the switch next to \'Allow notification access\'.</string>
    <string name="permission_instruction_step2">2. If you see the \'App was denied access\' or \'Restricted setting\' warning, tap \'OK\'.</string>
    <string name="permission_instruction_step3">3. Go to your home screen or app drawer, long-press the \'Notification Vault\' app icon, and tap \'App info\'.</string>
    <string name="permission_instruction_step4">4. On the App info screen, tap the three-dots menu in the top-right corner and select \'Allow restricted settings\'.</string>
    <string name="permission_instruction_step5">5. Authenticate using your fingerprint, face, or PIN to confirm.</string>
    <string name="permission_instruction_step6">6. Return to settings, turn on the \'Allow notification access\' switch again, and tap \'Allow\' on the confirmation popup.</string>
    <string name="permission_instruction_step7">7. Finally, ensure all the checkboxes are ticked (Real-time, Conversations, Notifications, Silent).</string>

